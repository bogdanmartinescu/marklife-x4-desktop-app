{
  "name": "thermalbridge",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm --filter @thermalbridge/desktop dev",
    "build": "pnpm --filter @thermalbridge/desktop build",
    "dist": "pnpm --filter @thermalbridge/desktop dist",
    "printbridge:build": "node scripts/build-printbridge.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/release-version.test.mjs",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "version:check": "node scripts/release-version.mjs check",
    "version:bump": "node scripts/release-version.mjs bump",
    "label:build": "pnpm --filter @thermalbridge/cli build-label"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
